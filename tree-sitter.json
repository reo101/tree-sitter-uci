{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "uci",
      "camelcase": "UCI",
      "title": "Unified Configuration Interface",
      "scope": "source.uci",
      "file-types": [
        "uci"
      ],
      "injection-regex": "^uci$",
      "class-name": "TreeSitterUci"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A system to centralize the configuration of OpenWrt services",
    "authors": [
      {
        "name": "Pavel Atanasov",
        "email": "pavel.atanasov2001@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/reo101/tree-sitter-uci"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}